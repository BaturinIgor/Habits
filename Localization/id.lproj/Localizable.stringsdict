<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld hari</string>
		</dict>
	</dict>
	<key>%lld habits left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld kebiasaan lagi</string>
		</dict>
	</dict>
	<key>%lld habits planned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld kebiasaan direncanakan</string>
		</dict>
	</dict>
	<key>%lld repeats every %lld min</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%1$lld kali setiap %2$lld menit</string>
		</dict>
	</dict>
	<key>%lld weeks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld minggu</string>
		</dict>
	</dict>
	<key>%lld times a week</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld kali seminggu</string>
		</dict>
	</dict>
</dict>
</plist>
