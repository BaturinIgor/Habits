<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day</string>
			<key>other</key>
			<string>%lld days</string>
		</dict>
	</dict>
	<key>%lld habits left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld habit left</string>
			<key>other</key>
			<string>%lld habits left</string>
		</dict>
	</dict>
	<key>%lld habits planned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld habit planned</string>
			<key>other</key>
			<string>%lld habits planned</string>
		</dict>
	</dict>
	<key>%lld repeats every %lld min</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld repeat every %2$lld min</string>
			<key>other</key>
			<string>%1$lld repeats every %2$lld min</string>
		</dict>
	</dict>
</dict>
</plist>
