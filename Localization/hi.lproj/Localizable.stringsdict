<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld दिन</string>
			<key>other</key>
			<string>%lld दिन</string>
		</dict>
	</dict>
	<key>%lld habits left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld आदत बाकी</string>
			<key>other</key>
			<string>%lld आदतें बाकी</string>
		</dict>
	</dict>
	<key>%lld habits planned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld आदत तय</string>
			<key>other</key>
			<string>%lld आदतें तय</string>
		</dict>
	</dict>
	<key>%lld repeats every %lld min</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>हर %2$lld मिनट में %1$lld बार</string>
			<key>other</key>
			<string>हर %2$lld मिनट में %1$lld बार</string>
		</dict>
	</dict>
	<key>%lld weeks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld हफ़्ता</string>
			<key>other</key>
			<string>%lld हफ़्ते</string>
		</dict>
	</dict>
	<key>%lld times a week</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>हफ़्ते में %lld बार</string>
			<key>other</key>
			<string>हफ़्ते में %lld बार</string>
		</dict>
	</dict>
</dict>
</plist>
